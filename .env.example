# Bitrix24 incoming webhook base URL.
# Keep the real value only in .env, not in code.
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/user_id/webhook_code/

# Custom deal field that stores the settlement/check-in date.
# Example: UF_CRM_1234567890
SETTLEMENT_DATE_FIELD=UF_CRM_1684488791039

# Deal field that stores the project/object value.
# Example: UF_CRM_0987654321
PROJECT_FIELD=UF_CRM_642A972B79B02

# Filled values in these fields exclude a deal from notifications.
# UF_CRM_1684488467570 = Дата (не разобрано)
# UF_CRM_1684488938076 = Дата (СТОП. вахта)
# UF_CRM_1702365176183 = Дата (Переведен)
# UF_CRM_1705411821048 = Трудоустроен
EXCLUDE_FILLED_FIELDS=UF_CRM_1684488467570,UF_CRM_1684488938076,UF_CRM_1702365176183,UF_CRM_1705411821048

# Task responsible user IDs for HR employees, comma-separated.
# We will fill these after checking user IDs for Минакова Анна and Турчина Юлия.
HR_RESPONSIBLE_IDS=4683,69625

# How many full days after settlement date should pass before alerting.
OLDER_THAN_DAYS=5

# Limit audit to deals changed recently, for example 365 days.
AUDIT_LOOKBACK_DAYS=365

# MAX bot values are intentionally not used by the first safe check.
# They will be added after the Bitrix check is verified.
MAX_BOT_TOKEN=
MAX_ADMIN_USER_ID=
MAX_ANDREY_USER_ID=
MAX_IVAN_USER_ID=
MAX_HUSAN_USER_ID=
MAX_ALEKSEY_USER_ID=
